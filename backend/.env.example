API_V1_STR=/api/v1
PROJECT_NAME=Smart Logistics Intelligence API
VERSION=1.0.0

# Database
# PostgreSQL database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_logistics

# Routing
