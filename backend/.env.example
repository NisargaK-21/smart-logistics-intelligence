API_V1_STR=/api/v1
PROJECT_NAME=Smart Logistics Intelligence API
VERSION=1.0.0

# Public OSRM demo service; provide a self-hosted OSRM endpoint for production.
OSRM_ROUTER_URL=https://router.project-osrm.org

# Open-Meteo is used for modelled current weather. Set false to disable weather.
WEATHER_AVAILABLE=true
GIS_SERVICE_ENABLED=true
RISK_SERVICE_ENABLED=true
RISK_SOURCE=baseline