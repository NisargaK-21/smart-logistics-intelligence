# Terrain raw data
# ==============================
ml/data/raw/terrain/

# ==============================
# Terrain processed data
# ==============================
ml/data/processed/terrain/

# ==============================
# Terrain final/ML datasets
# ==============================
ml/data/final/terrain_features.csv

# ==============================
# Large raster files
# ==============================
**/*.tif
**/*.tiff

# ==============================
# Jupyter
# ==============================
.ipynb_checkpoints/

# ==============================
# Environment files
# ==============================
.env
.env.*
!.env.example

# ==============================
# GPS simulator output
# ==============================
simulator/output/

# ==============================
# GPS datasets
# ==============================
ml/data/raw/gps/
ml/data/processed/gps/

# ==============================
# Historical raw data
# ==============================
ml/data/raw/historical/*

# ==============================
# Historical processed data
# ==============================
ml/data/processed/historical/

# ==============================

# Dataset 3 - Historical Disasters

# ==============================

# Exclude historical final datasets

ml/data/final/historical/

# Exclude generated historical disaster outputs

ml/data/processed/landslides/
ml/data/processed/floods/
ml/data/processed/disaster/
ml/data/processed/boundaries/

# Exclude downloaded raw boundary data

ml/data/raw/boundaries/

# Exclude Dataset 3 ZIP package

/Dataset3_Historical_Disasters.zip

# Exclude dataset backup files

**/*before_coordinate_fix*.csv
**/*before_status_fix*.csv

# Ignore backend virtual environment
/backend/.venv/
# ==============================
# Windows system files
# ==============================
desktop.ini